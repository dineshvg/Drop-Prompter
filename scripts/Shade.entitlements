<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Syntax highlighting runs highlight.js in JavaScriptCore, which compiles JavaScript at runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Terminal cards run arbitrary commands; some (osascript, open) send Apple Events. macOS still asks
         the user before any app can be controlled. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
